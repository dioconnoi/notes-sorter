# Copy this file to .env and fill in your own values.
# Every friend running notes-sorter uses their own independent copy —
# nothing here is shared infrastructure.

# --- LLM provider: choose one ---
LLM_PROVIDER=anthropic          # anthropic | openai | ollama
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Notion ---
# Create an internal integration at https://www.notion.so/my-integrations
# and share your workspace's target page with it.
NOTION_API_KEY=
NOTION_PARENT_PAGE_ID=          # page the bot provisions its databases under
# Filled in automatically by `notes-sorter-provision` the first time it runs:
NOTION_NOTES_DB_ID=
NOTION_TASKS_DB_ID=
NOTION_PROJECTS_DB_ID=

# Notion access strategy:
#   mcp  - use Claude's native remote-MCP connector to Notion's hosted MCP
#          server (requires LLM_PROVIDER=anthropic and a Notion MCP
#          integration token from https://www.notion.so/mcp)
#   api  - call the Notion REST API directly via NOTION_API_KEY (works with
#          any LLM_PROVIDER, used automatically as a fallback)
NOTION_ACCESS_MODE=api
NOTION_MCP_URL=https://mcp.notion.com/mcp
NOTION_MCP_TOKEN=

# --- Telegram ---
# Create your own bot via https://t.me/BotFather, one per person.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=      # comma-separated Telegram user IDs allowed to use your bot

# --- Google Keep (unofficial API, see docs/BLINDSPOTS.md) ---
GOOGLE_KEEP_EMAIL=
GOOGLE_KEEP_MASTER_TOKEN=

# --- Google Docs ---
GOOGLE_DOCS_CREDENTIALS_FILE=credentials.json
GOOGLE_DOCS_FOLDER_ID=           # optional: restrict to one Drive folder

# --- Scheduling ---
DIGEST_CRON=0 8 * * *            # daily 08:00, cron syntax
RESYNC_INTERVAL_MINUTES=60
TIMEZONE=Europe/London
